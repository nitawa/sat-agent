{
  "llm": {
    "base_url": "http://localhost:11434/v1",
    "api_key": "",
    "model": "deepseek-v4.1-flash:cloud",
    "ssl_cert_file": "",
    "temperature": 0.0,
    "timeout": 600,
    "max_retries": 3,
    "extra_headers": {},
    "extra_body": {}
  },
  "paths": {
    "sat": "../sat",
    "sat_salome": "../sat_salome",
    "work_root": "~/.local/share/sat-agent"
  },
  "application": "SALOME-master-native",
  "sat_overrides": ["APPLICATION.properties.git_server='github'"],
  "git": {
    "mode": "worktree",
    "branch_prefix": "sat-agent/",
    "commit": true
  },
  "docker": {
    "run_as_host_user": true,
    "extra_run_args": [],
    "make_jobs": 0,
    "verify_dockerfile": false
  },
  "web_search": {
    "backend": "duckduckgo",
    "searxng_url": "",
    "tavily_api_key": "",
    "max_results": 6
  },
  "tests": {
    "enabled": true,
    "use_xvfb": true,
    "ctest_args": ["--output-on-failure", "--timeout", "600"],
    "include": "",
    "exclude": "",
    "timeout_s": 21600
  },
  "trace": {
    "enabled": false,
    "file": ""
  },
  "memory": {
    "history_high": 60000,
    "history_low": 25000,
    "keep_turns": 3,
    "strip_think": true
  },
  "policy": {
    "sysdeps_passes": 4,
    "prepare_fix_attempts": 3,
    "compile_fix_attempts": 4,
    "agent_iteration_cap": 30,
    "max_test_cycles": 3,
    "on_failure": "abort",
    "command_timeout_s": 3600,
    "compile_timeout_s": 43200
  }
}
